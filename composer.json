{
    "name": "markocupic/contao-utf8-arrows-insert-tag-bundle",
    "description": "Insert utf8 arrows via contao insert tags",
    "keywords": [
        "contao",
        "bundle",
        "insert-tag",
        "arrows",
        "utf-8"
    ],
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Marko Cupic",
            "email": "m.cupic@gmx.ch",
            "homepage": "https://github.com/markocupic/contao-utf8-arrows-insert-tag-bundle",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/markocupic/contao-utf8-arrows-insert-tag-bundle/issues",
        "source": "https://github.com/markocupic/contao-utf8-arrows-insert-tag-bundle"
    },
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.3 || ^6.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.12",
        "contao/test-case": "^5.3 || ^6.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Markocupic\\ContaoUtf8ArrowsInsertTagBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markocupic\\ContaoUtf8ArrowsInsertTagBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Markocupic\\ContaoUtf8ArrowsInsertTagBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "cs-fixer": "@php .ecs/vendor/bin/ecs check --config .ecs/config/default.php --fix --ansi",
        "cs-check": "@php .ecs/vendor/bin/ecs check --config .ecs/config/default.php --ansi",
        "unit-tests": "@php vendor/bin/phpunit --colors=always"
    }
}
